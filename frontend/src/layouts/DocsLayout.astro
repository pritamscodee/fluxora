---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/Header.astro';
import { buildNav, flatNav } from '@/lib/nav';
import { RiArrowLeftLine, RiArrowRightLine, RiMenuLine } from 'react-icons/ri';

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  title: string;
  description: string;
  slug: string;
  section: string;
  accent?: string;
  headings?: Heading[];
}

const { title, description, slug, section, accent = 'yellow', headings = [] } = Astro.props;

const nav = await buildNav();
const flat = await flatNav();
const index = flat.findIndex((entry) => entry.slug === slug);
const previous = index > 0 ? flat[index - 1] : null;
const next = index >= 0 && index < flat.length - 1 ? flat[index + 1] : null;

// Only h2/h3 go in the contents panel; deeper levels make it unreadable.
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);
---

<BaseLayout title={title} description={description}>
  <Header />

  <div class="mx-auto flex max-w-[1500px] gap-0 px-0 lg:px-4">
    <!-- Sidebar -->
    <aside
      id="docs-sidebar"
      class="brutal-scroll fixed inset-y-0 left-0 z-40 hidden w-72 shrink-0 overflow-y-auto border-r-[3px] border-[var(--brutal-ink)] bg-background p-5 pt-20 lg:sticky lg:top-16 lg:block lg:h-[calc(100dvh-4rem)] lg:pt-6"
    >
      <nav class="space-y-7">
        {
          nav.map((group) => (
            <div>
              <h2 class="mb-2.5 border-b-[3px] border-[var(--brutal-ink)] pb-1 text-[11px] font-extrabold uppercase tracking-[0.12em]">
                {group.section}
              </h2>
              <ul class="space-y-1">
                {group.entries.map((entry) => (
                  <li>
                    <a
                      href={`/docs/${entry.slug}`}
                      class:list={[
                        'block border-2 px-2.5 py-1.5 text-[13px] font-semibold leading-snug',
                        entry.slug === slug
                          ? 'border-[var(--brutal-ink)] text-[#0b0b0b] shadow-[3px_3px_0_0_var(--brutal-ink)]'
                          : 'border-transparent hover:border-[var(--brutal-ink)] hover:bg-muted',
                      ]}
                      style={
                        entry.slug === slug
                          ? `background:var(--brutal-${entry.accent})`
                          : undefined
                      }
                    >
                      {entry.title}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </nav>
    </aside>

    <!-- Main -->
    <main class="min-w-0 flex-1 px-4 py-10 lg:px-10">
      <div class="mb-8">
        <div class="mb-3 flex flex-wrap items-center gap-2">
          <span
            class="brutal-tag text-[#0b0b0b]"
            style={`background:var(--brutal-${accent})`}
          >
            {section}
          </span>
          <button
            type="button"
            data-sidebar-toggle
            class="brutal-tag bg-card lg:hidden"
            aria-label="Toggle navigation"
          >
            <RiMenuLine size={13} /> Menu
          </button>
        </div>
        <h1 class="text-4xl leading-[1.05] sm:text-5xl">{title}</h1>
        <p class="mt-4 max-w-2xl text-base font-medium text-muted-foreground">
          {description}
        </p>
        <div class="mt-6 border-t-4 border-[var(--brutal-ink)]"></div>
      </div>

      <article class="docs-prose">
        <slot />
      </article>

      <!-- Prev / next -->
      <nav class="mt-16 grid gap-4 sm:grid-cols-2">
        {
          previous ? (
            <a
              href={`/docs/${previous.slug}`}
              class="brutal brutal-press group bg-card p-4"
            >
              <span class="flex items-center gap-1.5 text-[11px] font-extrabold uppercase tracking-widest text-muted-foreground">
                <RiArrowLeftLine size={13} /> Previous
              </span>
              <span class="mt-1.5 block font-[family-name:var(--font-heading)] text-lg leading-tight">
                {previous.title}
              </span>
            </a>
          ) : (
            <span />
          )
        }
        {
          next && (
            <a
              href={`/docs/${next.slug}`}
              class="brutal brutal-press group bg-card p-4 sm:text-right"
            >
              <span class="flex items-center gap-1.5 text-[11px] font-extrabold uppercase tracking-widest text-muted-foreground sm:justify-end">
                Next <RiArrowRightLine size={13} />
              </span>
              <span class="mt-1.5 block font-[family-name:var(--font-heading)] text-lg leading-tight">
                {next.title}
              </span>
            </a>
          )
        }
      </nav>
    </main>

    <!-- Contents -->
    {
      toc.length > 1 && (
        <aside class="sticky top-16 hidden h-[calc(100dvh-4rem)] w-60 shrink-0 overflow-y-auto py-10 pr-4 xl:block">
          <h2 class="mb-3 border-b-[3px] border-[var(--brutal-ink)] pb-1 text-[11px] font-extrabold uppercase tracking-[0.12em]">
            On this page
          </h2>
          <ul class="space-y-1.5 text-[13px]">
            {toc.map((heading) => (
              <li class={heading.depth === 3 ? 'pl-3' : ''}>
                <a
                  href={`#${heading.slug}`}
                  data-toc-link={heading.slug}
                  class="block border-l-[3px] border-transparent pl-2 font-medium leading-snug text-muted-foreground hover:border-[var(--brutal-ink)] hover:text-foreground"
                >
                  {heading.text}
                </a>
              </li>
            ))}
          </ul>
        </aside>
      )
    }
  </div>

  <footer class="mt-20 border-t-[3px] border-[var(--brutal-ink)] bg-card">
    <div
      class="mx-auto flex max-w-[1500px] flex-wrap items-center gap-3 px-5 py-6 text-xs font-semibold uppercase tracking-wider"
    >
      <span>Fluxora</span>
      <span class="text-muted-foreground">Agentic video infrastructure</span>
      <span class="ml-auto text-muted-foreground">
        Built with Astro, Tailwind and shadcn/ui
      </span>
    </div>
  </footer>

  <script is:inline>
    // Mobile sidebar.
    document.addEventListener('click', (event) => {
      if (event.target.closest('[data-sidebar-toggle]')) {
        document.getElementById('docs-sidebar')?.classList.toggle('hidden');
      }
    });

    // Highlight the contents entry for whatever heading is currently on screen.
    const links = document.querySelectorAll('[data-toc-link]');
    if (links.length) {
      const byId = new Map();
      links.forEach((link) => byId.set(link.dataset.tocLink, link));
      const observer = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            const link = byId.get(entry.target.id);
            if (!link) continue;
            if (entry.isIntersecting) {
              links.forEach((l) =>
                l.classList.remove('border-[var(--brutal-ink)]', 'text-foreground'),
              );
              link.classList.add('border-[var(--brutal-ink)]', 'text-foreground');
            }
          }
        },
        { rootMargin: '-80px 0px -70% 0px', threshold: 0 },
      );
      document
        .querySelectorAll('.docs-prose h2[id], .docs-prose h3[id]')
        .forEach((heading) => observer.observe(heading));
    }
  </script>
</BaseLayout>
