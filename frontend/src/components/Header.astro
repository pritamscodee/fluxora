---
import { RiGithubFill, RiSunLine, RiMoonLine, RiTerminalBoxLine } from 'react-icons/ri';

const nav = [
  { href: '/docs/introduction', label: 'Docs' },
  { href: '/docs/api-overview', label: 'API' },
  { href: '/docs/agent-overview', label: 'Agent' },
  { href: '/docs/architecture', label: 'Architecture' },
];

const path = Astro.url.pathname;
---

<header
  class="sticky top-0 z-50 border-b-[3px] border-[var(--brutal-ink)] bg-background/95 backdrop-blur"
>
  <div class="mx-auto flex h-16 max-w-[1500px] items-center gap-4 px-4">
    <a href="/" class="group flex items-center gap-2.5 shrink-0">
      <span
        class="brutal-sm flex size-9 items-center justify-center bg-[var(--brutal-yellow)] text-[#0b0b0b]"
      >
        <RiTerminalBoxLine size={19} />
      </span>
      <span class="font-[family-name:var(--font-heading)] text-xl tracking-tight">
        FLUXORA
      </span>
      <span
        class="brutal-tag hidden bg-[var(--brutal-lime)] text-[#0b0b0b] sm:inline-flex"
      >
        docs
      </span>
    </a>

    <nav class="ml-4 hidden items-center gap-1 md:flex">
      {
        nav.map((item) => (
          <a
            href={item.href}
            class:list={[
              'border-2 border-transparent px-3 py-1.5 text-sm font-bold uppercase tracking-wide',
              path.startsWith(item.href)
                ? 'border-[var(--brutal-ink)] bg-[var(--brutal-cyan)] text-[#0b0b0b]'
                : 'hover:border-[var(--brutal-ink)] hover:bg-[var(--brutal-yellow)] hover:text-[#0b0b0b]',
            ]}
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="ml-auto flex items-center gap-2">
      <button
        data-theme-toggle
        type="button"
        aria-label="Toggle colour theme"
        class="brutal-sm brutal-press flex size-9 items-center justify-center bg-card"
      >
        <span class="dark:hidden"><RiMoonLine size={17} /></span>
        <span class="hidden dark:inline"><RiSunLine size={17} /></span>
      </button>
      <a
        href="https://github.com"
        rel="noopener"
        aria-label="Source repository"
        class="brutal-sm brutal-press flex size-9 items-center justify-center bg-card"
      >
        <RiGithubFill size={18} />
      </a>
    </div>
  </div>
</header>
