---
interface Props {
  value: string;
  label: string;
  accent?: 'yellow' | 'lime' | 'cyan' | 'pink' | 'orange' | 'violet';
}
const { value, label, accent = 'yellow' } = Astro.props;
---

<div class="brutal bg-card p-4" >
  <div
    class="mb-2 inline-block border-2 border-[var(--brutal-ink)] px-2 py-0.5 font-[family-name:var(--font-heading)] text-2xl"
    style={`background:var(--brutal-${accent});color:#0b0b0b`}
  >
    {value}
  </div>
  <div class="text-xs font-bold uppercase tracking-wider text-muted-foreground">{label}</div>
</div>
