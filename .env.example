# ---- Database (Neon Postgres) ----
# Use the pooled connection string; append ?sslmode=require
DATABASE_URL=postgresql+asyncpg://user:pass@ep-xxx.region.aws.neon.tech/fluxora

# ---- Auth ----
JWT_SECRET=change-me-openssl-rand-hex-32
ACCESS_TOKEN_TTL_MINUTES=30
REFRESH_TOKEN_TTL_DAYS=30
# RS256 keypair for signed playback tokens (PEM, base64-encoded)
PLAYBACK_SIGNING_PRIVATE_KEY=
PLAYBACK_SIGNING_KEY_ID=

# ---- Object storage (S3-compatible: MinIO/SeaweedFS locally, R2 or S3 in production) ----
# Local dev: `docker compose up -d` then use the values below as-is.
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY_ID=fluxora
S3_SECRET_ACCESS_KEY=fluxora-dev-secret
S3_BUCKET=fluxora
S3_REGION=us-east-1
# MinIO/SeaweedFS serve buckets as a path segment, not a subdomain.
S3_FORCE_PATH_STYLE=true
# Set only when the API reaches storage on a different host than the browser does
# (e.g. the API is in Docker but clients are not). Presigned URLs are signed per host.
S3_PUBLIC_ENDPOINT=
S3_CREATE_BUCKET=true
#
# Cloudflare R2 instead: same backend, only these change.
#   S3_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
#   S3_REGION=auto

# ---- Media processing ----
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
WORKER_CONCURRENCY=2
MEDIA_SCRATCH_DIR=./tmp


# ---- Observability ----
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=fluxora-api

# ---- App ----
ENVIRONMENT=development
API_BASE_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000

# ---- LLM / agent (LangGraph + LangSmith) ----
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
LLM_TEMPERATURE=0.0

LANGSMITH_API_KEY=
LANGSMITH_PROJECT=fluxora
LANGSMITH_TRACING=false

# ---- Agent guardrails (hard ceilings, enforced in code) ----
AGENT_MAX_PLAN_STEPS=8
AGENT_MAX_TOOL_CALLS=12
AGENT_MAX_RUNS_PER_HOUR=60
AGENT_MAX_PROMPT_CHARS=8000
# Never turn this off outside a sandbox: it is what stops the agent running
# expensive or destructive tools without a human saying yes.
AGENT_REQUIRE_APPROVAL=true

# Optional Guardrails AI Hub validators (comma-separated). Install each first with
# `guardrails hub install hub://<name>`; missing ones are skipped with a warning.
GUARDRAILS_INPUT_VALIDATOR_NAMES=
GUARDRAILS_OUTPUT_VALIDATOR_NAMES=

# ---- Redis / BullMQ (agent tool dispatch; 5 attempts then dead-letter) ----
REDIS_URL=redis://localhost:6379/0
AGENT_TOOL_QUEUE=fluxora-agent-tools
AGENT_TOOL_CONCURRENCY=4
AGENT_TOOL_TIMEOUT_SECONDS=900
